# Every variable from docs/build-spec.md section 3. Empty means "use the default in
# backend/app/config.py" (defaults are listed in the spec). DRAFT values belong to the
# cybersec team; change them here and in the spec table together.

APP_ENV=
DATABASE_URL=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=
LLM_SCHEMA_RETRIES=

# generate with: openssl rand -hex 32
INGEST_TOKEN=
# separate credential for the authentication producer (it can state authorized=false)
AUTH_INGEST_TOKEN=
# recorded on every login event, e.g. lab-auth
AUTH_INGEST_PRODUCER=
CORS_ORIGINS=

EVE_JSON_PATH=
INGEST_URL=
# optional: the shipper also follows the lab auth log so brute force opens an incident
# without a Suricata alert (docs/log-schema.md)
SHIPPER_AUTH_LOG_PATH=
AUTH_INGEST_URL=

ACCESS_LOG_PATH=
AUTH_LOG_PATH=
PROCESS_LOG_PATH=

# DRAFT
INCIDENT_GROUP_WINDOW_SECONDS=
CORRELATION_WINDOW_BEFORE_SECONDS=
CORRELATION_WINDOW_SECONDS=
BRUTE_FORCE_MIN_FAILURES=
BRUTE_FORCE_WINDOW_SECONDS=
PIPELINE_DEBOUNCE_SECONDS=
# comma-separated names or paths of the web server process, pending Q12 (e.g. the app's
# interpreter or server binary); empty means RCE can never be confirmed
WEB_SERVER_EXES=
# comma-separated Suricata signature ids of the lab's own rules; a match sets the attack
# type in code, which early warnings need
RCE_SIGNATURE_IDS=
BRUTE_FORCE_SIGNATURE_IDS=

MAX_EVIDENCE_ROUNDS=

# PAMELA (spec section 13). DRAFT: highest rules severity PAMELA may act on without a
# person (none|low|medium|high|critical; none turns it off)
PAMELA_MAX_SEVERITY=
BLOCK_DURATION_SECONDS=
# comma-separated IPs or CIDRs that are never blocked (lab hosts, analysts' network)
PROTECTED_IPS=
# the lab sends it as X-Enforcement-Token to GET /enforcement; empty turns the endpoint
# off. generate with: openssl rand -hex 32
ENFORCEMENT_TOKEN=
# comma-separated name:token pairs for people who approve, reject or revert actions,
# e.g. "analyst-a:<openssl rand -hex 32>". Each call sends X-Operator-Token; the recorded
# name comes from this map, not from the request. Empty turns the response endpoints off.
OPERATOR_TOKENS=

NEXT_PUBLIC_API_BASE_URL=

# signs approved maintenance operations in the isolated lab (openssl rand -hex 32)
LAB_APPROVAL_SECRET=
